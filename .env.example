DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/kardata
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/kardata_test
PORT=8787
# Comma list of addresses to listen on: loopback + the kardata_agents gateway
# (created by `npm run harness:setup`). Agent containers reach MCP at the
# gateway; never 0.0.0.0.
HOST=127.0.0.1,172.31.250.1
# Silence (no stdout events, no MCP calls) before an agent run is stalled.
AGENT_STALL_SECONDS=300
# Engine caps (each also runtime-tunable via MCP settings tools).
MAX_CONCURRENT_AGENTS=4
COLLECT_CONCURRENCY=3
# Company pipeline: how many company jobs run at once (1..100).
COMPANY_CONCURRENCY=4
KARDATA_OPERATOR_TOKEN=change-me-to-a-long-random-string
KARDATA_IMPORT_DIRS=/home/karthik/Downloads
COMPANIES_HOUSE_API_KEY=
KARDATA_CONTACT_URL=
KARDATA_CONTACT_EMAIL=
# Pinned version of the app-owned Muse in the kardata_muse volume.
# Written by `npm run harness:setup`; on mismatch kardata-server boots with agent runs disabled.
KARDATA_MUSE_VERSION=
