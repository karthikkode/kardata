{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "./backend/vitest.mutation.config.ts",
    "related": false
  },
  "mutate": [
    "backend/src/db/workspace.ts",
    "backend/src/mcp/tools.ts",
    "backend/src/temporal/activities/turn.ts"
  ],
  "ignorePatterns": [
    "var/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/dist/**",
    "reports/**"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "concurrency": 2,
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental-backend-mutation.json",
  "thresholds": { "high": 80, "low": 70, "break": 70 },
  "dryRunTimeoutMinutes": 60
}
