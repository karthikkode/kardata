# Prod UI: static nginx serving the production vite build (SPA fallback).
# Build from the repo root (stack.mjs prod deploy does this):
# docker build -f deployment/Dockerfile.ui \
#   --build-arg GIT_SHA=... --build-arg VITE_STAGING_URL=... \
#   --build-arg VITE_STAGING_KEY=... .
# The UI key bakes in at deploy time (local image only, never pushed).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
COPY agents/package.json agents/package.json
COPY backend/package.json backend/package.json
RUN npm ci
COPY frontend/index.html frontend/vite.config.ts frontend/
# tsconfig.test.json must EXIST (vite walks the reference graph) but is
# never typechecked here: the build below covers app+node projects only,
# and the tests tree it points at stays out of the image.
COPY frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/tsconfig.test.json frontend/
COPY frontend/public frontend/public
COPY frontend/src frontend/src
ARG VITE_STAGING_API=1
ARG VITE_STAGING_URL
ARG VITE_STAGING_KEY
ENV VITE_STAGING_API=$VITE_STAGING_API VITE_STAGING_URL=$VITE_STAGING_URL VITE_STAGING_KEY=$VITE_STAGING_KEY
# App-only: tsconfig.json also references tsconfig.test.json (tests tree),
# which is deliberately absent from this image. Typecheck + bundle src.
RUN cd frontend && npx tsc -b tsconfig.app.json tsconfig.node.json && npx vite build

FROM nginx@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
# Source SHA the image was built from; doctor compares it against
# origin/prod so a stale UI fails loudly instead of silently.
ARG GIT_SHA=unknown
LABEL org.kardata.git-sha=$GIT_SHA
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY deployment/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
