# Prod secrets template. Copy to agents/.env INSIDE the prod worktree
# (/home/karthik/projects/kardata_prod/agents/.env — an ignored file,
# never committed), then fill the values.
#
# Provider keys (Meta vendor account, etc.) are NOT listed here: prod
# inherits the staging checkout's agents/.env automatically
# (KARDATA_STAGING_DIR env_file). Add overrides below only if prod
# must use different provider keys than staging.
#
# The one required value:

# UI key baked into the prod nginx image at deploy time (VITE_STAGING_KEY).
# Generate once, keep it in the prod agents/.env only.
KARDATA_UI_KEY=paste-owner-ui-key-here

# Optional overrides (defaults shown):
# KARDATA_UI_API_URL=http://127.0.0.1:4001
# KARDATA_CORS_ORIGINS=http://localhost:45174,http://127.0.0.1:45174
