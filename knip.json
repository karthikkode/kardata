{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["var/**", "**/test-results/**", "**/coverage/**", "**/dist/**"],
  "ignoreBinaries": ["prlimit"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "deployment/scripts/*.mjs", "tests/**/*.ts"],
      "paths": {
        "@/*": ["./frontend/src/*"]
      },
      "ignoreDependencies": ["pg", "fastify", "zod", "unpdf", "sharp", "@opentelemetry/api", "@temporalio/activity", "@temporalio/client", "@temporalio/common", "@temporalio/proto", "@temporalio/testing", "@temporalio/worker", "@temporalio/workflow", "playwright-core", "react", "@testing-library/react", "@testing-library/user-event", "@playwright/test", "sonner", "lucide-react", "@assistant-ui/react", "@axe-core/playwright"],
      "project": ["scripts/*.mjs", "deployment/scripts/*.mjs", "tests/**/*.ts"]
    },
    "agents": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "!src/fixtures/**"]
    },
    "backend": {
      "entry": ["src/server.ts", "src/temporal/dev-worker.ts", "src/db/cli.ts", "src/temporal/workflows/*.ts", "src/temporal/activities/*.ts", "*.config.ts"],
      "project": ["src/**/*.ts", "*.config.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx", "src/test/**", "src/**/*.test.{ts,tsx}", "*.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"],
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono", "shadcn", "tw-animate-css", "tailwindcss", "@tanstack/react-virtual"]
    }
  }
}
