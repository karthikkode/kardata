{
  "name": "kardata-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check && astro build && node scripts/check-dist.mjs && vitest run",
    "og": "google-chrome --headless=new --hide-scrollbars --allow-file-access-from-files --window-size=1200,627 --screenshot=public/og-default.png \"file://$PWD/scripts/og-image.html\"",
    "deploy": "bash ../deploy/deploy.sh",
    "rollback": "bash ../deploy/rollback.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
