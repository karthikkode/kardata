---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/collection";
import { readingMinutes } from "../../lib/posts";
import "../../styles/page.css";

const posts = await getPosts();
---
<Base title="Blog" description="One sourced piece a week on the decisions a D2C brand makes, and the numbers behind them.">
  <PageHeader
    eyebrow="Blog"
    title="One piece a week"
    lead="The everyday decisions a brand makes, what's at stake, and the numbers behind them."
  />
  <section class="wrap page-body">
    {posts.length === 0 && <p class="empty">The first piece is on its way.</p>}
    <div class="list">
      {posts.map((p) => (
        <PostCard
          id={p.id}
          title={p.data.title}
          summary={p.data.summary}
          date={p.data.date}
          minutes={readingMinutes(p.body)}
          draft={p.data.draft}
        />
      ))}
    </div>
  </section>
</Base>

<style>
  .list {
    display: grid;
    gap: 1rem;
  }
  .empty {
    padding: 2rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    text-align: center;
  }
</style>
