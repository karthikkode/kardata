---
// The owner's own words from the v1 site ("Who I am"), with the 2026 photo.
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BookButton from "../../components/BookButton.astro";
import FounderCard from "../../components/FounderCard.astro";
import portrait from "../../assets/karthik-portrait.jpg";
import "../../styles/page.css";

const pillars = [
  { title: "Scale", text: "Pipelines that move billions of rows a night, and keep running the morning after." },
  { title: "Migration", text: "Legacy systems moved to modern stacks while the old one keeps serving customers." },
  { title: "Reliability", text: "Systems built to fail loudly, not silently. The quiet break is the expensive one." },
  { title: "AI on my own hardware", text: "Models running locally. Your data never has to leave the building." },
];
---
<Base title="About" description="Insurance, AI, and large-scale data. That's the background Kardata is built on.">
  <article class="wrap page">
    <span class="eyebrow">Who I am</span>
    <h1 class="title">I solve data problems. That's the work I've been doing for years.</h1>
    <p class="lead">Insurance, AI, and large-scale data. That's the background Kardata is built on.</p>

    <Image src={portrait} alt="Sai Karthik" widths={[600, 1200]} sizes="(min-width: 72rem) 72rem, 100vw" class="portrait" loading="eager" />

    <FounderCard>
      <p class="motto">AI only where it pays for itself.</p>
    </FounderCard>

    <div class="grid grid-2 pillars">
      {pillars.map((p) => (
        <div class="card">
          <h2>{p.title}</h2>
          <p>{p.text}</p>
        </div>
      ))}
    </div>

    <div class="cta-row"><BookButton label="Book a 20-minute call" size="lg" /></div>
  </article>
</Base>

<style>
  .title {
    max-width: 44rem;
  }
  .page :global(.portrait) {
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    margin: 2.5rem 0 1.5rem;
  }
  .pillars {
    margin-top: 1rem;
  }
  .pillars h2 {
    font-size: 1.05rem;
    margin: 0;
  }
  .pillars p {
    margin: 0.6rem 0 0;
  }
  .motto {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-bright);
  }
</style>
