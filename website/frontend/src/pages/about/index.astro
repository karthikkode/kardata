---
// About, aimed at D2C owners (owner, 2026-10-27: no data-engineering background). Each line comes from
// strategy.md, offer.md or website.md.
import { CALL_LABEL } from "../../config";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import BookButton from "../../components/BookButton.astro";
import FounderCard from "../../components/FounderCard.astro";
import portrait from "../../assets/karthik-portrait.jpg";
import "../../styles/page.css";

const pillars = [
  {
    title: "Your own data, read-only",
    text: "I work from read-only exports. Nothing changes in your systems.",
  },
  {
    title: "One question at a time",
    text: "Every engagement starts with one business question, answered at a fixed price. You keep the report, whatever happens next.",
  },
  {
    title: "In your money and your time",
    text: "Every finding comes with what it costs you per month and how that number was worked out, so you can check the maths.",
  },
  {
    title: "Next to your team, not instead of it",
    text: "I work on the gaps between systems that nobody owns, alongside your agencies and the people you've hired.",
  },
];
---
<Base title="About" description="I help D2C brands see where time and money leak between their systems.">
  <PageHeader
    eyebrow="Who I am"
    title="I help D2C brands see where time and money leak between their systems."
    lead="Your store, Amazon, your retailers, your warehouse and your accounts each hold part of the picture. My work is the gap between them that nobody owns."
  />
  <article class="wrap page-body">

    <div class="intro">
      <Image src={portrait} alt="Sai Karthik" widths={[600, 1200]} sizes="(min-width: 900px) 22rem, 100vw" class="portrait" loading="eager" />
      <FounderCard>
        <p class="motto">AI only where it pays for itself.</p>
      </FounderCard>
    </div>

    <h2 class="how">How I work</h2>
    <div class="grid grid-2 pillars">
      {pillars.map((p) => (
        <div class="card">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>

    <div class="cta-band">
      <p>Start with one question.</p>
      <BookButton label={CALL_LABEL} size="lg" />
    </div>
  </article>
</Base>

<style>
  /* Photo and founder card side by side, so the page has one clear starting point. */
  .intro {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .intro :global(.portrait) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
  }
  @media (max-width: 899px) {
    .intro :global(.portrait) {
      max-width: 22rem;
    }
  }
  .pillars {
    margin-top: 1rem;
  }
  .how {
    margin: 3.5rem 0 1.25rem;
  }
  .pillars h3 {
    font-size: 1.05rem;
    margin: 0;
  }
  .pillars p {
    margin: 0.6rem 0 0;
  }
  .motto {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-bright);
  }
</style>
