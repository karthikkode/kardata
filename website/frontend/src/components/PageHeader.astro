---
// The same header on every inner page: eyebrow, title, intro, then a divider before the content.
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<header class="page-header">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding: 4.5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    background: radial-gradient(ellipse 60% 120% at 0% 0%, rgba(79, 156, 249, 0.07), transparent 70%);
  }
  h1 {
    margin-top: 0.9rem;
    max-width: 46rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
  }
  .lead {
    margin: 1rem 0 0;
    max-width: 40rem;
  }
</style>
