---
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import { buildSeo, type SeoInput } from "../lib/seo";
import { SITE } from "../config";

interface Props extends Omit<SeoInput, "path"> {
  noindex?: boolean;
}
const { noindex = false, ...rest } = Astro.props;
const seo = buildSeo({ ...rest, path: Astro.url.pathname });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {!noindex && <link rel="canonical" href={seo.canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0c10" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {!noindex && <meta property="og:url" content={seo.canonical} />}
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <Analytics />
    <!-- Content is hidden for the scroll reveal only when the script below can show it again. -->
    <script is:inline>
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade each block up as it scrolls into view; items inside a grid follow one after another.
      const root = document.documentElement;
      if (root.classList.contains("js")) {
        const groups = ".grid, .deliverables, .types, .posts, .list";
        const blocks: Element[] = [];
        document.querySelectorAll("main .section .wrap > *, main .page-body > *").forEach((el) => {
          if (!el.matches(groups)) return void blocks.push(el);
          Array.from(el.children).forEach((child, i) => {
            (child as HTMLElement).style.setProperty("--stagger", `${Math.min(i, 5) * 0.08}s`);
            blocks.push(child);
          });
        });
        const seen = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              el.classList.add("in");
              seen.unobserve(el);
              // Hand the element back to its own styles once it has arrived.
              setTimeout(() => el.classList.remove("reveal"), 900);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const el of blocks) {
          el.classList.add("reveal");
          seen.observe(el);
        }
      }
    </script>
  </body>
</html>
