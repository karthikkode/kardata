[Unit]
Description=kardata-server (MCP backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/kardata
EnvironmentFile=%h/projects/kardata/.env
# Point PATH at a Node 22 install so `npm start` uses it; adjust if yours differs.
Environment=PATH=%h/.nvm/versions/node/v22.23.3/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.23.3/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
